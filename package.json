{
  "name": "@fishlikewater/dsh-mcp-manager",
  "version": "0.3.2",
  "description": "MCP 服务器管理器：在 DSH 设置页配置 MCP 服务器（写在本条目的 config.servers），宿主按配置挂载/卸载 mcp-client 实例",
  "type": "module",
  "main": "index.js",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "plugin",
    "settings"
  ],
  "license": "MIT",
  "author": "zhangxiang <zhangxiang@uphicoo.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fishlikewater/dsh-mcp-manager.git"
  },
  "homepage": "https://github.com/fishlikewater/dsh-mcp-manager#readme",
  "bugs": {
    "url": "https://github.com/fishlikewater/dsh-mcp-manager/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-mcp-client": "0.1.0-rc.6 || 0.1.1-rc.2 || 0.1.7-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
