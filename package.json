{
  "name": "@fishlikewater/dsh-mcp-manager",
  "version": "0.4.0",
  "description": "在 DSH 设置页里管理 MCP 服务器，保存即挂载或卸载 mcp-client 实例",
  "type": "module",
  "main": "index.js",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "plugin",
    "settings"
  ],
  "license": "MIT",
  "author": "zhangxiang <zhangxiang@uphicoo.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fishlikewater/dsh-mcp-manager.git"
  },
  "homepage": "https://github.com/fishlikewater/dsh-mcp-manager#readme",
  "bugs": {
    "url": "https://github.com/fishlikewater/dsh-mcp-manager/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.1.7-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-mcp-client": ">=0.1.0-rc.6 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "scripts": {
    "test": "node test/host.selftest.mjs && node test/client.selftest.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "npm test && npm run check:pack"
  }
}
