{
  "name": "@fishlikewater/dsh-mcp-manager",
  "version": "0.2.1",
  "description": "MCP 服务器管理器：在 DSH 设置页配置 MCP 服务器，宿主侧按配置热挂载/卸载 mcp-client 实例",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "plugin",
    "settings"
  ],
  "license": "MIT",
  "author": "zhangxiang <fishlijewater@126.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fishlikewater/dsh-mcp-manager.git"
  },
  "homepage": "https://github.com/fishlikewater/dsh-mcp-manager#readme",
  "bugs": {
    "url": "https://github.com/fishlikewater/dsh-mcp-manager/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.6"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-mcp-client": ">=0.1.0-rc.6 <0.2.0"
  },
  "scripts": {
    "test": "node --test",
    "check:pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "npm test && npm run check:pack"
  }
}
